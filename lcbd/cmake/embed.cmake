set(BYTES_PER_LINE 16)

string(REPLACE "|" ";" FILES "${FILES}")
string(REPEAT "0x..," ${BYTES_PER_LINE} line_pattern)
set(code "// generated by cmake/embed.cmake - do not edit\n#include \"web_assets.h\"\n\n")
set(table "")
set(n_assets 0)
foreach(file ${FILES})
    get_filename_component(name ${file} NAME)
    get_filename_component(extension ${file} EXT)
    if(extension STREQUAL ".html")
        set(type "text/html; charset=utf-8")
    elseif(extension STREQUAL ".js")
        set(type "application/javascript; charset=utf-8")
    elseif(extension STREQUAL ".css")
        set(type "text/css; charset=utf-8")
    else()
        set(type "application/octet-stream")
    endif()
    file(READ ${file} hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR len "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" bytes "${bytes}")
    string(APPEND code "static const unsigned char asset${n_assets}[] = {\n${bytes}0x00};\n\n")
    string(APPEND table "    {\"/${name}\", \"${type}\", asset${n_assets}, ${len}},\n")
    math(EXPR n_assets "${n_assets} + 1")
endforeach()
string(APPEND code "const WebAsset web_assets[] = {\n${table}};\nconst size_t n_web_assets = ${n_assets};\n")
file(WRITE ${OUT} "${code}")
